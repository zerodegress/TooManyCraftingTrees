{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/jei-recipe-scan.schema.json",
  "title": "TMCT JEI Recipe Scan",
  "description": "Schema for files generated by /tmct dump-recipes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "includeHidden": {
      "type": "boolean"
    },
    "recipeTypeCount": {
      "type": "integer",
      "minimum": 0
    },
    "recipeCount": {
      "type": "integer",
      "minimum": 0
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/recipeData"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "generatedAt",
    "includeHidden",
    "recipeTypeCount",
    "recipeCount",
    "recipes",
    "errors"
  ]
}
