{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/crafting-tree.schema.json",
  "title": "TMCT Crafting Tree",
  "description": "Schema for files generated by /tmct tree.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "includeHidden": {
      "type": "boolean"
    },
    "recipeLibrary": {
      "type": [
        "string",
        "null"
      ]
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0
    },
    "scannedRecipeCount": {
      "type": "integer",
      "minimum": 0
    },
    "target": {
      "$ref": "common.schema.json#/$defs/ingredientData"
    },
    "requestedAmount": {
      "type": "integer",
      "minimum": 0
    },
    "root": {
      "$ref": "#/$defs/craftingTreeNode"
    },
    "baseMaterials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amountedIngredient"
      }
    },
    "byproducts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amountedIngredient"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedIngredient"
      }
    }
  },
  "required": [
    "generatedAt",
    "includeHidden",
    "recipeLibrary",
    "maxDepth",
    "scannedRecipeCount",
    "target",
    "requestedAmount",
    "root",
    "baseMaterials",
    "byproducts",
    "unresolved"
  ],
  "$defs": {
    "craftingTreeNode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingredient": {
          "$ref": "common.schema.json#/$defs/ingredientData"
        },
        "requestedAmount": {
          "type": "integer",
          "minimum": 0
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unkeyed",
            "cycle",
            "depth_limit",
            "base",
            "missing_library_recipe",
            "ambiguous",
            "invalid_recipe_output",
            "crafted",
            null
          ]
        },
        "selectedRecipeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedRecipeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedRecipeSource": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "library",
            "only_candidate",
            null
          ]
        },
        "candidateRecipeCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidateRecipes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputPerCraft": {
          "type": "integer",
          "minimum": 0
        },
        "crafts": {
          "type": "integer",
          "minimum": 0
        },
        "producedAmount": {
          "type": "integer",
          "minimum": 0
        },
        "surplusAmount": {
          "type": "integer",
          "minimum": 0
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/craftingTreeInput"
          }
        }
      },
      "required": [
        "ingredient",
        "requestedAmount",
        "depth",
        "status",
        "selectedRecipeId",
        "selectedRecipeType",
        "selectedRecipeSource",
        "candidateRecipeCount",
        "candidateRecipes",
        "outputPerCraft",
        "crafts",
        "producedAmount",
        "surplusAmount",
        "inputs"
      ]
    },
    "craftingTreeInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "selected",
            "no_keyed_ingredient",
            null
          ]
        },
        "slotName": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ingredientData"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredAmount": {
          "type": "integer",
          "minimum": 0
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ingredientData"
          }
        },
        "child": {
          "anyOf": [
            {
              "$ref": "#/$defs/craftingTreeNode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "slotName",
        "selected",
        "requiredAmount",
        "alternatives",
        "child"
      ]
    },
    "amountedIngredient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingredient": {
          "$ref": "common.schema.json#/$defs/ingredientData"
        }
      },
      "required": [
        "ingredient"
      ]
    },
    "unresolvedIngredient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingredient": {
          "$ref": "common.schema.json#/$defs/ingredientData"
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ingredient",
        "amount",
        "reason"
      ]
    }
  }
}
