{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/simpletree.schema.json",
  "title": "TMCT Simple Tree",
  "description": "Schema for files generated by /tmct simpletree.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "includeHidden": {
      "type": "boolean"
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0
    },
    "brief": {
      "$ref": "#/$defs/simpleRecipeSummary"
    },
    "tree": {
      "$ref": "#/$defs/simpleTreeNode"
    }
  },
  "required": [
    "generatedAt",
    "includeHidden",
    "maxDepth",
    "brief",
    "tree"
  ],
  "$defs": {
    "simpleItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "item",
        "tag",
        "count"
      ]
    },
    "simpleRecipeSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "$ref": "#/$defs/simpleItem"
        },
        "byproducts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/simpleItem"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/simpleItem"
          }
        }
      },
      "required": [
        "recipeType",
        "output",
        "byproducts",
        "inputs"
      ]
    },
    "simpleTreeNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "recipe"
            },
            "recipeId": {
              "type": [
                "string",
                "null"
              ]
            },
            "recipeType": {
              "type": [
                "string",
                "null"
              ]
            },
            "crafts": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "$ref": "#/$defs/simpleItem"
            },
            "byproducts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/simpleItem"
              }
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/simpleTreeNode"
              }
            }
          },
          "required": [
            "type",
            "recipeId",
            "recipeType",
            "crafts",
            "output",
            "byproducts",
            "inputs"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "raw"
            },
            "output": {
              "$ref": "#/$defs/simpleItem"
            }
          },
          "required": [
            "type",
            "output"
          ]
        }
      ]
    }
  }
}
